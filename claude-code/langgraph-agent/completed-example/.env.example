# このファイルをコピーして .env を作成してください
# cp .env.example .env

# Anthropic API Key
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_api_key_here

# Logging
LOG_LEVEL=INFO

# Optional: LangSmith (デバッグ・トレース用)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_key
# LANGCHAIN_PROJECT=langgraph-agent
