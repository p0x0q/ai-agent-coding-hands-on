FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy all files
COPY . .

# Expose port
EXPOSE 3000

# Start development server with hot reload
CMD ["npx", "next", "dev", "--hostname", "0.0.0.0"]
